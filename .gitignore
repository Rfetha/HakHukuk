# runlock (yarış koruması) — süreç ömrü boyunca duran geçici kilit dosyaları
*.lock

# Ara/ham çalışma verisi — üretilebilir, provenansı outputs/ künyelerinde (OSS temizliği 2026-08-03)
data/_ham_ve_ara/

# Retriever indeksi — türetilmiş artefakt (korpus + gömme modelinden ~10 dk'da yeniden kurulur).
# KUNYE.json kalır (ölçüm künyesi), gömme matrisi git'e girmez.
data/index/**/*.npy

# S2 korpus yedeği — tek seferlik, git tarihçesi zaten yedek
data/corpus/*.yedek-*
data/eval/**/*.yedek-*

# pytest önbelleği — ne ignore ne tracked'tı (T3, 2026-09-06)
.pytest_cache/
